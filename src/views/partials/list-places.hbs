{{#each places}}
    {{#if ../isPublic}}
    <div class="box box-link-hover-shadow">
        <h2 class="title">
            {{name}} ({{category}})
        </h2>

        <div class="is-flex is-align-items-center">
            <a href="/place/{{_id}}" class="button">
            <span class="icon">
                <i class="fa-solid fa-circle-info fa-lg"></i>
            </span>
            </a>
            <p class="ml-5">Added by: {{userid.firstName}} {{userid.lastName}}</p>
        </div>
    </div>
    {{else}}
   <div class="box box-link-hover-shadow">
        <h2 class="title">
            {{name}} ({{category}})
        </h2>
        <a href="/place/{{_id}}" class="button">
            <span class="icon">
                <i class="fa-solid fa-circle-info fa-lg"></i>
            </span>
        </a>
        <a href="/place/{{_id}}/deletePlace" class="button">
            <span class="icon">
                <i class="fas fa-trash fa-lg"></i>
            </span>
        </a>
    </div> 
    {{/if}}
{{/each}}