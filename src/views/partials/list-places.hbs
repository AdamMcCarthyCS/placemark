{{#if places}}
  {{#each places}}
      {{#if ../admin }}
      <!-- This lists places in the admin places page -->
      <div class="box box-link-hover-shadow">
          <h2 class="title">
              {{name}} ({{category}})
          </h2>
          <!-- admin version of request details page (added ?from=private query parameter) -->
          <div class="is-flex align-items-center">
              <a href="/place/{{_id}}?from=admin" class="button">
                  <span class="icon">
                      <i class="fa-solid fa-circle-info fa-lg"></i>
                  </span>
              </a>
              <a href="/place/{{_id}}/deletePlace" class="button">
                  <span class="icon">
                      <i class="fas fa-trash fa-lg"></i>
                  </span>
              </a>
                <p class="ml-5 py-2">Added by: {{userid.firstName}} {{userid.lastName}}</p>
          </div>
      </div> 
      <!-- This lists places in the user public page -->
      {{else if ../isPublic}}
      <div class="box box-link-hover-shadow">
          <h2 class="title">
              {{name}} ({{category}})
          </h2>

          <div class="is-flex is-align-items-center">
              <!-- public version of requesting details page (added?from=public query parameter) -->
              <a href="/place/{{_id}}?from=public" class="button">
              <span class="icon">
                  <i class="fa-solid fa-circle-info fa-lg"></i>
              </span>
              </a>
              <p class="ml-5 py-2">Added by: {{userid.firstName}} {{userid.lastName}}</p>
          </div>
      </div>
      {{else}}
      <!-- this list places in the user my-places page -->
    <div class="box box-link-hover-shadow">
          <h2 class="title">
              {{name}} ({{category}})
          </h2>
          <!-- private version of request details page (added ?from=private query parameter) -->
          <a href="/place/{{_id}}?from=private" class="button">
              <span class="icon">
                  <i class="fa-solid fa-circle-info fa-lg"></i>
              </span>
          </a>
          <a href="/place/{{_id}}/deletePlace" class="button">
              <span class="icon">
                  <i class="fas fa-trash fa-lg"></i>
              </span>
          </a>
      </div> 
      {{/if}}
  {{/each}}
{{else}}
<div class="box box-link-hover-shadow">
    <p class="is-size-5 has-text-weight-bold">No places to show in {{#if category}} {{category}}{{else}} All{{/if}}...</p>
</div>
{{/if}}