{{#each places}}
    <div class="box box-link-hover-shadow">
        <h2 class="title">
            {{name}} ({{category}})
        </h2>
        <a href="/place/{{_id}}" class="button">
            <span class="icon is-small">
                <i class="fas fa-folder-open"></i>
            </span>
        </a>
        <a href="/place/{{_id}}/deletePlace" class="button">
            <span class="icon is-small">
                <i class="fas fa-trash"></i>
            </span>
        </a>
    </div>
{{/each}}