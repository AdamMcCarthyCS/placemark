{{#each places}}
    {{#if ../admin }}
    <div class="box box-link-hover-shadow">
        <h2 class="title">
            {{name}} ({{category}})
        </h2>
        <!-- admin version of request details page (added ?from=private query parameter) -->
        <a href="/place/{{_id}}?from=admin" class="button">
            <span class="icon">
                <i class="fa-solid fa-circle-info fa-lg"></i>
            </span>
        </a>
        <a href="/place/{{_id}}/deletePlace" class="button">
            <span class="icon">
                <i class="fas fa-trash fa-lg"></i>
            </span>
        </a>
    </div> 
    {{else if ../isPublic}}
    <div class="box box-link-hover-shadow">
        <h2 class="title">
            {{name}} ({{category}})
        </h2>

        <div class="is-flex is-align-items-center">
            <!-- public version of requesting details page (added?from=public query parameter) -->
            <a href="/place/{{_id}}?from=public" class="button">
            <span class="icon">
                <i class="fa-solid fa-circle-info fa-lg"></i>
            </span>
            </a>
            <p class="ml-5">Added by: {{userid.firstName}} {{userid.lastName}}</p>
        </div>
    </div>
    {{else}}
   <div class="box box-link-hover-shadow">
        <h2 class="title">
            {{name}} ({{category}})
        </h2>
        <!-- private version of request details page (added ?from=private query parameter) -->
        <a href="/place/{{_id}}?from=private" class="button">
            <span class="icon">
                <i class="fa-solid fa-circle-info fa-lg"></i>
            </span>
        </a>
        <a href="/place/{{_id}}/deletePlace" class="button">
            <span class="icon">
                <i class="fas fa-trash fa-lg"></i>
            </span>
        </a>
    </div> 
    {{/if}}
{{/each}}