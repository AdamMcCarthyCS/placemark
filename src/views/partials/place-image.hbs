<div class="card">
  <div class="card-image">
    <figure class="image is-3by2">
      <img src={{place.img}}>
    </figure>
  </div>
  <!-- only the owner is allowed to upload an image -->
  <!-- if admin is unhappy with image they have option to delete place. In V2 I will possibly allow admin to reset image -->
  {{#if isOwner }}
  <div class="card-content">
    <form action="/place/{{place._id}}/uploadimage" method="POST" enctype="multipart/form-data">
      <div id="file-select" class="file has-name is-fullwidth">
        <label class="file-label"> <input class="file-input" name="imagefile" type="file" name="resume" accept="image/png, image/jpeg">
          <span class="file-cta">
            <span class="file-icon">
              <i class="fas fa-upload"></i>
            </span>
            <span class="file-label">
              Choose a file…
            </span>
           </span>
          <span class="file-name"></span>
        </label>
        <button type="submit" class="button is-info">Upload</button>
      </div>
    </form>
  </div>
</div>
{{/if}}
<script>
  const fileInput = document.querySelector(".file-input");
  fileInput.onchange = () => {
    if (fileInput.files.length > 0) {
      const fileName = document.querySelector(".file-name");
      fileName.textContent = fileInput.files[0].name;
    }
  };
</script>
